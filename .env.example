# Vacío = mismo origen + proxy Vite (/api → localhost:4000). También válido: http://localhost:4000
VITE_API_URL=http://localhost:4000
# Producción: https://api.tudominio.com
# Widget asistente en landing (false para ocultar sin tocar backend)
VITE_ENABLE_CHAT_WIDGET=true
VITE_CHAT_SSE=true
# Timeout stream chat (ms). Prod: 120000 recomendado
# VITE_CHAT_STREAM_TIMEOUT_MS=120000
